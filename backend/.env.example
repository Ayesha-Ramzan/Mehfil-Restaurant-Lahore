# Copy this file to .env and fill in your values.
# .env is ignored by .gitignore — never commit real secrets.

# Port the API listens on (default: 3001)
PORT=3001

# Database URL when you wire persistence
# DATABASE_URL=

# WhatsApp Business API credentials (when moving off wa.me links)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Email / SMS providers (for confirmations)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=